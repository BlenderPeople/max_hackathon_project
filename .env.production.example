# Copy this file to .env on the VPS. Do not commit the real .env.
POSTGRES_DB=max_app
POSTGRES_USER=max_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://max_app:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/max_app

APP_ENV=production
APP_DOMAIN=max.example.ru
CORS_ORIGINS=https://max.example.ru
MAX_APP_URL=https://max.example.ru

# Backend-only secrets. Never place these in frontend variables or Git.
MAX_BOT_TOKEN=REPLACE_WITH_THE_TEAM_BOT_TOKEN
MAX_WEBHOOK_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
MAX_BOT_USERNAME=t216_hakaton_bot
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_CA_BUNDLE_PATH=/etc/ssl/certs/ca-certificates.crt
MAX_INIT_DATA_MAX_AGE_SECONDS=3600
SESSION_TTL_SECONDS=3600

# Public build-time value, safe to expose.
VITE_MAX_BOT_USERNAME=t216_hakaton_bot

FILE_STORAGE_DIR=/app/data/uploads
MAX_UPLOAD_BYTES=10485760
