# PostgreSQL (used by Docker Compose)
POSTGRES_DB=max_app
POSTGRES_USER=max_app
POSTGRES_PASSWORD=change-me-locally

# Backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg://max_app:change-me-locally@db:5432/max_app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_MODE=mock
SEED_DEMO_DATA=1

# MAX — fill only in your local .env; never expose these in the frontend
MAX_BOT_TOKEN=
# Generate a 32+ character value locally. Allowed for a MAX webhook secret:
# letters, digits, underscores and hyphens only. Never commit the resulting .env.
MAX_WEBHOOK_SECRET=
MAX_BOT_USERNAME=t216_hakaton_bot
MAX_APP_URL=http://localhost:5173
MAX_API_BASE_URL=https://platform-api2.max.ru
# Linux container bundle; do not point this to a browser/frontend certificate.
MAX_CA_BUNDLE_PATH=/etc/ssl/certs/ca-certificates.crt
MAX_INIT_DATA_MAX_AGE_SECONDS=3600
SESSION_TTL_SECONDS=3600
# Optional: set these to real MAX user IDs before running the demo seed.
DEMO_MASTER_MAX_ID=900000001
DEMO_CUSTOMER_MAX_ID=900000002
FILE_STORAGE_DIR=/app/data/uploads
MAX_UPLOAD_BYTES=10485760

# Object storage (implemented later by the MAX/infrastructure owner)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
